.generic-graph{font:13px 'Avenir Next',sans-serif;color:#23445b;background:#f4f9fc;border:1px solid #d5e5ec;border-radius:10px;overflow:hidden}.graph-tools{display:flex;align-items:center;gap:12px;padding:10px 15px;background:#eaf2f7;border-bottom:1px solid #d5e5ec;font-size:11px;color:#648494}.graph-tools button{margin-left:auto;border:1px solid #bfd4df;border-radius:5px;background:white;padding:5px 10px;color:#285870}.generic-graph svg{display:block;width:100%;height:260px;background-image:radial-gradient(#bcd6df 1px,transparent 1px);background-size:18px 18px;touch-action:none}.graph-edge{fill:none;stroke:#84a7b5;stroke-width:1.5;opacity:.75}.graph-edge.related{stroke:#078d87;stroke-width:2.7;opacity:1}.graph-node{cursor:grab}.graph-node.selected>circle:first-child{stroke-width:5}.graph-role{font-size:13px;font-weight:750;fill:#23445b}.graph-name{font-size:11px;fill:#6c8795}.graph-hint{font-size:10px;color:#6c8795;margin:0;padding:8px 15px;border-top:1px solid #d5e5ec}@media(max-width:700px){.generic-graph svg{height:260px}}